APP_ENV=local
APP_NAME="Life Drawing Randburg"
APP_URL=http://localhost/lifedrawing
APP_BASE_PATH=/lifedrawing/public
# Community WhatsApp group invite. Defaults to the real group in config/app.php.
APP_WHATSAPP_URL=https://chat.whatsapp.com/DIuJ2yPbjpG350Ovjxj1Hx
# Sitter-queue auto-completion. Leave off until the backlog has been swept with
# tools/fix-sitter-queue.php, then set to true. See deploy/README.md.
APP_SITTER_AUTO_COMPLETE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lifedrawing
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@lifedrawingrandburg.co.za
MAIL_FROM_NAME="Life Drawing Randburg"
