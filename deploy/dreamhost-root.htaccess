RewriteEngine On

# Life Drawing Randburg — route /randburg/* to the app
# Place this at ~/lifedrawing.andresclements.com/.htaccess
#
# IMPORTANT: the rewrite rules in this file DO NOT apply to /randburg/*.
#
# randburg/.htaccess turns RewriteEngine on, and Apache does not inherit
# mod_rewrite rules from a parent directory's .htaccess. The live routing chain
# is randburg/.htaccess -> public/ -> public/.htaccess -> front controller, so
# everything below is effectively dead code for the app. It is kept because it
# is harmless and would matter if that file ever went away.
#
# This matters most for the maintenance gate. A gate placed here parses fine, and
# a syntax error in it breaks every request to the site — so it looks active —
# but not one of its rules ever fires. The gate therefore lives in the
# repository's own root .htaccess, which is the file that actually governs the
# app. See deploy/README.md.

# Static files: serve directly from public/
RewriteCond %{DOCUMENT_ROOT}/randburg/public/$1 -f
RewriteRule ^randburg/(.+)$ randburg/public/$1 [L]

# Everything else: front controller
RewriteRule ^randburg(/.*)?$ randburg/public/index.php [L]
